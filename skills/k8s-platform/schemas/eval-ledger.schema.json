{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crm-sre:schemas:eval-ledger",
  "title": "External evaluation ledger; real records are excluded from release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runs"],
  "properties": {
    "schema": {"const": "crm-sre-eval-ledger/v1"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "passed", "failed", "not_run", "host_limit"],
      "properties": {
        "cases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0},
        "host_limit": {"type": "integer", "minimum": 0},
        "results": {"type": "object", "additionalProperties": {"enum": ["PASS", "PASS_WITH_KNOWN_ISSUES", "FAIL", "BLOCKED", "NOT_RUN", "HOST_LIMIT"]}}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "version", "revision", "host_version", "model", "criteria_version", "build_identity", "regression_seconds", "duration_note", "sets", "evidence", "known_issues"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "host_version": {"type": "string", "minLength": 1},
        "model": {"const": "glm-5.3-flash"},
        "criteria_version": {"type": "string", "minLength": 1},
        "build_identity": {
          "type": "object", "additionalProperties": false,
          "required": ["source_commit", "manifest_sha256", "zip_sha256", "probe_version", "machine", "identity_note"],
          "properties": {
            "source_commit": {"type": ["string", "null"]},
            "manifest_sha256": {"type": ["string", "null"]},
            "zip_sha256": {"type": ["string", "null"]},
            "probe_version": {"type": ["string", "null"]},
            "machine": {"const": "Mac"},
            "identity_note": {"type": "string", "minLength": 1}
          }
        },
        "regression_seconds": {"type": ["number", "null"], "minimum": 0},
        "duration_note": {"type": "string", "minLength": 1},
        "sets": {
          "type": "object", "additionalProperties": false,
          "required": ["golden", "exceptional", "safety"],
          "properties": {
            "golden": {"$ref": "#/$defs/set"},
            "exceptional": {"$ref": "#/$defs/set"},
            "safety": {"$ref": "#/$defs/set"}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "known_issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
