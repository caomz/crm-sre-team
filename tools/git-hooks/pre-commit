#!/bin/sh
# Pre-commit gate (F6): rebuild from the STAGED tree and refuse the commit if
# the staged build-owned outputs are stale — without ever rewriting the
# working tree.
#
# Mechanics: export the index to a temp dir (git checkout-index), run
# tools/build_bundle.py --root there, and compare hashes of the build-owned
# outputs before/after the rebuild. A diff means the staged outputs are
# stale: the commit is rejected, the user re-runs the build and re-stages.
# The working tree is untouched by this hook on every code path.
#
# Install with:  python tools/install_git_hooks.py
#   (sets core.hooksPath to tools/git-hooks and is idempotent)
# Bypass (deliberately):  git commit --no-verify
#
# No extension on this filename is intentional: git resolves hooks by exact
# name. This file is a local dev tool and is deliberately absent from
# release-manifest.json, which only governs packaged release contents.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Find a real python: try python3, python, then py -3 (Windows launcher).
# Each candidate must actually run (-c "import sys") so the Windows Store
# python3 stub does not silently pass the command -v check.
PY=""
if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
    PY="python"
elif command -v py >/dev/null 2>&1 && py -3 -c "import sys" >/dev/null 2>&1; then
    PY="py -3"
fi
if [ -z "$PY" ]; then
    echo "pre-commit: FAILED - no working python3/python/py -3 on PATH; commit aborted." >&2
    echo "pre-commit: activate an existing Python environment and retry; the gate cannot run without Python." >&2
    exit 1
fi

tmp_root=$(CDPATH= cd -P "${TMPDIR:-/tmp}" && pwd -P)
tmp_base=$(mktemp -d "$tmp_root/crm-precommit.XXXXXX")
# Keep the original shell path immutable for cleanup, even on MSYS.
readonly tmp_root tmp_base
cleanup() {
    cleanup_status=$?
    trap - EXIT
    trap '' INT TERM
    # User decision, 2026-10-10: the hook cleans only its own mktemp directory.
    # Refuse ambiguous paths; a warning must never change the commit verdict.
    if [ -z "$tmp_base" ]; then
        echo "pre-commit: WARNING - cleanup refused: empty temporary path." >&2
        exit "$cleanup_status"
    fi
    if [ ! -d "$tmp_base" ] || [ -L "$tmp_base" ]; then
        echo "pre-commit: WARNING - cleanup refused: not a directory or is a symlink: $tmp_base" >&2
        exit "$cleanup_status"
    fi
    cleanup_parent=$(CDPATH= cd -P "${tmp_base%/*}" 2>/dev/null && pwd -P) || cleanup_parent=""
    if [ "${tmp_base%/*}" != "$tmp_root" ] || [ "$cleanup_parent" != "$tmp_root" ]; then
        echo "pre-commit: WARNING - cleanup refused: temporary parent changed: $tmp_base" >&2
        exit "$cleanup_status"
    fi
    case "${tmp_base##*/}" in
        crm-precommit.?*) ;;
        *)
            echo "pre-commit: WARNING - cleanup refused: unexpected directory prefix: $tmp_base" >&2
            exit "$cleanup_status"
            ;;
    esac
    # Windows cannot remove a directory that is still the current directory.
    if ! cd "$repo_root"; then
        echo "pre-commit: WARNING - cleanup failed: cannot leave the staged directory: $tmp_base" >&2
    elif ! rm -rf -- "$tmp_base" 2>/dev/null; then
        echo "pre-commit: WARNING - cleanup failed for temporary directory: $tmp_base" >&2
    fi
    exit "$cleanup_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# MSYS/git-bash only: give git/python a mixed Windows path while retaining
# the recorded shell path above for validation and cleanup.
export_base="$tmp_base"
if command -v cygpath >/dev/null 2>&1; then
    export_base=$(cygpath -m "$tmp_base")
fi
export_dir="$export_base/export"
mkdir -p "$export_dir"

# Export the STAGED tree (the index), not the working tree, then work there.
git checkout-index -a --prefix="$export_dir/"
cd "$export_dir"

owned_find() {
    find agents skills templates manual-mode individual-packages -type f 2>/dev/null || true
}

hashes() {
    owned_find | LC_ALL=C sort | while IFS= read -r f; do
        printf '%s  %s\n' "$(git hash-object -- "$f")" "$f"
    done
    if [ -f prompt-bundles.lock ]; then
        printf '%s  %s\n' "$(git hash-object -- prompt-bundles.lock)" "prompt-bundles.lock"
    fi
}

hashes > "$tmp_base/before.txt"

# Build from the exported staged tree; --root keeps every write inside it.
# Run the STAGED copy of tools/build_bundle.py from the export dir (not the
# working-tree one): an unstaged edit to the build script must not change
# the verdict.
# shellcheck disable=SC2086
if ! $PY "$export_dir/tools/build_bundle.py" --root "$export_dir" >/dev/null 2>&1; then
    echo "pre-commit: FAILED - tools/build_bundle.py (staged copy) exited non-zero on the staged tree." >&2
    echo "pre-commit: run it manually to see the error; commit aborted; working tree untouched." >&2
    exit 1
fi

hashes > "$tmp_base/after.txt"

if ! cmp -s "$tmp_base/before.txt" "$tmp_base/after.txt"; then
    echo "pre-commit: FAILED - staged build-owned outputs are stale." >&2
    diff "$tmp_base/before.txt" "$tmp_base/after.txt" \
        | grep '^>' | sed -e 's/^> [0-9a-f]*  /pre-commit:   /' >&2 || true
    echo "pre-commit: run the build yourself, then re-stage the rebuilt files and commit again:" >&2
    echo "pre-commit:   python tools/build_bundle.py && git add agents skills templates manual-mode individual-packages prompt-bundles.lock" >&2
    echo "pre-commit: the working tree was NOT modified by this hook." >&2
    exit 1
fi

exit 0
