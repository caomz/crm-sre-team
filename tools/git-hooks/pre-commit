#!/bin/sh
# Pre-commit gate (F6): rebuild from the STAGED tree and refuse the commit if
# the staged build-owned outputs are stale — without ever rewriting the
# working tree.
#
# Mechanics: export the index to a temp dir (git checkout-index), run
# tools/build_bundle.py --root there, and compare hashes of the build-owned
# outputs before/after the rebuild. A diff means the staged outputs are
# stale: the commit is rejected, the user re-runs the build and re-stages.
# The working tree is untouched by this hook on every code path.
#
# Install with:  python tools/install_git_hooks.py
#   (sets core.hooksPath to tools/git-hooks and is idempotent)
# Bypass (deliberately):  git commit --no-verify
#
# No extension on this filename is intentional: git resolves hooks by exact
# name. This file is a local dev tool and is deliberately absent from
# release-manifest.json, which only governs packaged release contents.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Choose the interpreter by capability, not by name. The staged build needs
# the project's declared runtime: Python 3.11+ (README) with PyYAML, the only
# third-party module the build imports (requirements-build.txt). A name-only
# check accepted, for example, the macOS system /usr/bin/python3 (3.9): it
# runs "import sys" but cannot run the build, so every commit failed with an
# unexplained "exited non-zero". Running the probe also rejects the Windows
# Store python3 stub. CRM_SRE_PYTHON, when non-empty, is the only candidate:
# an explicit choice must not silently fall back to PATH. Empty counts as
# unset, so `CRM_SRE_PYTHON= git commit` bypasses an exported override; PATH
# candidates still face the same probe. Otherwise try python3, python, then
# py -3 (Windows launcher). The probe stays on one line so native Windows
# interpreters receive it unchanged.
py_probe='import sys; v = sys.version_info; sys.exit("Python %d.%d.%d is older than 3.11" % tuple(v[:3])) if v < (3, 11) else None; import yaml'
nl='
'
cr=$(printf '\r')
py_rejected=""
python_found() {
    if command -v "$1" >/dev/null 2>&1; then
        return 0
    fi
    py_rejected="$py_rejected${nl}pre-commit:   $1: not found on PATH"
    return 1
}
python_works() {
    # $1 labels the candidate in diagnostics; the remaining words run it.
    py_label=$1
    shift
    if py_out=$("$@" -c "$py_probe" 2>&1); then
        return 0
    fi
    py_out=${py_out##*"$nl"}
    py_out=${py_out%"$cr"}
    py_rejected="$py_rejected${nl}pre-commit:   $py_label: ${py_out:-exited non-zero without output}"
    return 1
}
py_choice=""
if [ -n "${CRM_SRE_PYTHON:-}" ]; then
    case "$CRM_SRE_PYTHON" in
        /*|[A-Za-z]:/*|[A-Za-z]:\\*) ;;
        # A relative path (either separator) names a file in the repository;
        # the build runs later from the export directory, so anchor it now.
        # Bare names use PATH. Anything else fails visibly at the probe.
        */*|*\\*) CRM_SRE_PYTHON="$repo_root/$CRM_SRE_PYTHON" ;;
    esac
    if python_works "CRM_SRE_PYTHON ($CRM_SRE_PYTHON)" "$CRM_SRE_PYTHON"; then
        py_choice=override
    fi
elif python_found python3 && python_works python3 python3; then
    py_choice=python3
elif python_found python && python_works python python; then
    py_choice=python
elif python_found py && python_works "py -3" py -3; then
    py_choice=py
fi
# The positional parameters hold the selected command (one or two words).
case "$py_choice" in
    override) set -- "$CRM_SRE_PYTHON" ;;
    python3) set -- python3 ;;
    python) set -- python ;;
    py) set -- py -3 ;;
    *)
        if [ -n "${CRM_SRE_PYTHON:-}" ]; then
            echo "pre-commit: FAILED - CRM_SRE_PYTHON does not meet the project runtime (Python 3.11+ with PyYAML); commit aborted." >&2
        else
            echo "pre-commit: FAILED - no working python3/python/py -3 on PATH meets the project runtime (Python 3.11+ with PyYAML); commit aborted." >&2
        fi
        printf '%s\n' "${py_rejected#"$nl"}" >&2
        echo "pre-commit: point CRM_SRE_PYTHON at the project environment's interpreter (installed from requirements-dev.txt), or put it first on PATH, then retry; the gate cannot run without it." >&2
        exit 1
        ;;
esac

tmp_root=$(CDPATH= cd -P "${TMPDIR:-/tmp}" && pwd -P)
tmp_base=$(mktemp -d "$tmp_root/crm-precommit.XXXXXX")
# Keep the original shell path immutable for cleanup, even on MSYS.
readonly tmp_root tmp_base
cleanup() {
    cleanup_status=$?
    trap - EXIT
    trap '' INT TERM
    # User decision, 2026-10-10: the hook cleans only its own mktemp directory.
    # Refuse ambiguous paths; a warning must never change the commit verdict.
    if [ -z "$tmp_base" ]; then
        echo "pre-commit: WARNING - cleanup refused: empty temporary path." >&2
        exit "$cleanup_status"
    fi
    if [ ! -d "$tmp_base" ] || [ -L "$tmp_base" ]; then
        echo "pre-commit: WARNING - cleanup refused: not a directory or is a symlink: $tmp_base" >&2
        exit "$cleanup_status"
    fi
    cleanup_parent=$(CDPATH= cd -P "${tmp_base%/*}" 2>/dev/null && pwd -P) || cleanup_parent=""
    if [ "${tmp_base%/*}" != "$tmp_root" ] || [ "$cleanup_parent" != "$tmp_root" ]; then
        echo "pre-commit: WARNING - cleanup refused: temporary parent changed: $tmp_base" >&2
        exit "$cleanup_status"
    fi
    case "${tmp_base##*/}" in
        crm-precommit.?*) ;;
        *)
            echo "pre-commit: WARNING - cleanup refused: unexpected directory prefix: $tmp_base" >&2
            exit "$cleanup_status"
            ;;
    esac
    # Windows cannot remove a directory that is still the current directory.
    if ! cd "$repo_root"; then
        echo "pre-commit: WARNING - cleanup failed: cannot leave the staged directory: $tmp_base" >&2
    elif ! rm -rf -- "$tmp_base" 2>/dev/null; then
        echo "pre-commit: WARNING - cleanup failed for temporary directory: $tmp_base" >&2
    fi
    exit "$cleanup_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# MSYS/git-bash only: give git/python a mixed Windows path while retaining
# the recorded shell path above for validation and cleanup.
export_base="$tmp_base"
if command -v cygpath >/dev/null 2>&1; then
    export_base=$(cygpath -m "$tmp_base")
fi
export_dir="$export_base/export"
mkdir -p "$export_dir"

# Export the STAGED tree (the index), not the working tree, then work there.
git checkout-index -a --prefix="$export_dir/"
cd "$export_dir"

owned_find() {
    # dsh/ is the active build-owned delivery; the older trees stay monitored
    # so retained historical fixtures and regression builds keep working.
    for owned_dir in agents skills templates manual-mode individual-packages dsh; do
        if [ -e "$owned_dir" ] || [ -L "$owned_dir" ]; then
            find "$owned_dir" -type f || return 1
        fi
    done
}

hashes() {
    # Keep enumeration and sorting out of pipelines: POSIX sh has no pipefail.
    if ! owned_find > "$tmp_base/owned-raw.txt"; then
        echo "pre-commit: FAILED - build-owned file enumeration failed; commit aborted." >&2
        return 1
    fi
    if ! LC_ALL=C sort "$tmp_base/owned-raw.txt" > "$tmp_base/owned-sorted.txt"; then
        echo "pre-commit: FAILED - build-owned file sorting failed; commit aborted." >&2
        return 1
    fi
    while IFS= read -r f; do
        if ! file_hash=$(git hash-object -- "$f") || [ -z "$file_hash" ]; then
            echo "pre-commit: FAILED - git hash-object failed for $f; commit aborted." >&2
            return 1
        fi
        printf '%s  %s\n' "$file_hash" "$f" || return 1
    done < "$tmp_base/owned-sorted.txt"
    if [ -f prompt-bundles.lock ]; then
        if ! file_hash=$(git hash-object -- prompt-bundles.lock) || [ -z "$file_hash" ]; then
            echo "pre-commit: FAILED - git hash-object failed for prompt-bundles.lock; commit aborted." >&2
            return 1
        fi
        printf '%s  %s\n' "$file_hash" "prompt-bundles.lock" || return 1
    fi
    return 0
}

hashes > "$tmp_base/before.txt" || exit 1

# Build from the exported staged tree; --root keeps every write inside it.
# Run the STAGED copy of tools/build_bundle.py from the export dir (not the
# working-tree one): an unstaged edit to the build script must not change
# the verdict. "$@" is the interpreter selected above.
if ! "$@" "$export_dir/tools/build_bundle.py" --root "$export_dir" >/dev/null 2>&1; then
    echo "pre-commit: FAILED - tools/build_bundle.py (staged copy) exited non-zero on the staged tree." >&2
    echo "pre-commit: run it manually with the same interpreter ($*) to see the error; commit aborted; working tree untouched." >&2
    exit 1
fi

hashes > "$tmp_base/after.txt" || exit 1

if ! cmp -s "$tmp_base/before.txt" "$tmp_base/after.txt"; then
    echo "pre-commit: FAILED - staged build-owned outputs are stale." >&2
    diff "$tmp_base/before.txt" "$tmp_base/after.txt" \
        | grep '^>' | sed -e 's/^> [0-9a-f]*  /pre-commit:   /' >&2 || true
    echo "pre-commit: run the build yourself, then re-stage the rebuilt files and commit again:" >&2
    echo "pre-commit:   python tools/build_bundle.py && git add agents skills templates manual-mode individual-packages dsh prompt-bundles.lock" >&2
    echo "pre-commit: the default build resolves the manifest default_target (dsh); pass --target workbuddy only for historical regression." >&2
    echo "pre-commit: the working tree was NOT modified by this hook." >&2
    exit 1
fi

exit 0
